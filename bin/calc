#!/usr/bin/env python3
"""Arithmetic, so sums and splits come from code: calc "3*45 + 20"  ·  calc "(1200 - 340) / 4"  ·  calc "2:30 + 1:45"
Numbers, + - * / // % **, brackets, and h:mm durations (the result is then h:mm too)."""
import ast, operator, re, sys

OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
       ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.Pow: operator.pow, ast.USub: operator.neg, ast.UAdd: operator.pos}


def ev(n):
    if isinstance(n, ast.Constant) and type(n.value) in (int, float):
        return n.value
    if isinstance(n, ast.BinOp) and type(n.op) in OPS:
        if isinstance(n.op, ast.Pow) and abs(ev(n.right)) > 100:
            raise ValueError("exponent too large")
        return OPS[type(n.op)](ev(n.left), ev(n.right))
    if isinstance(n, ast.UnaryOp) and type(n.op) in OPS:
        return OPS[type(n.op)](ev(n.operand))
    raise ValueError("only numbers and + - * / // % ** ( ) are allowed")


def calc(expr):
    hm = re.search(r"\d+:\d\d", expr)
    expr = re.sub(r"(\d+):(\d\d)", lambda m: f"({m[1]}*60+{m[2]})", expr.replace(",", ""))
    v = ev(ast.parse(expr, mode="eval").body)
    if hm:
        return f"{'-' if v < 0 else ''}{int(abs(v)) // 60}:{int(abs(v)) % 60:02d}"
    return str(round(v, 6)).removesuffix(".0") if isinstance(v, float) else str(v)


if __name__ == "__main__":
    if sys.argv[1:] == ["--test"]:
        assert calc("3*45 + 20") == "155" and calc("(1200 - 340) / 4") == "215" and calc("10/3") == "3.333333"
        assert calc("2:30 + 1:45") == "4:15" and calc("1,200 * 2") == "2400"
        for bad in ("__import__('os')", "2**1000", "a+1"):
            try:
                calc(bad)
                raise AssertionError(bad)
            except (ValueError, SyntaxError):
                pass
        print("ok")
    elif not sys.argv[1:]:
        print(__doc__)
    else:
        try:
            print(calc(" ".join(sys.argv[1:])))
        except (ValueError, SyntaxError, ZeroDivisionError) as e:
            sys.exit(f"Couldn't calculate that: {e}")
